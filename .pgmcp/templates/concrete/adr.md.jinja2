{#- concrete/adr.md.jinja2 - Architectural Decision Record Template -#}
{#- Version: 1.1.0 -#}
{#- Purpose: Documenting architecturally significant decisions with agent guardrails -#}
{%- extends "tier2_base_markdown.jinja2" -%}

{%- import "tier3_pattern_markdown_status_header.jinja2" as hdr -%}
{%- import "tier3_pattern_markdown_purpose_scope.jinja2" as ps -%}
{%- import "tier3_pattern_markdown_prerequisites.jinja2" as prereq -%}
{%- import "tier3_pattern_markdown_related_docs.jinja2" as related -%}
{%- import "tier3_pattern_markdown_version_history.jinja2" as history -%}

{#-
TEMPLATE_METADATA:
  enforcement: STRICT
  level: structure
  extends: tier2_base_markdown.jinja2
  purpose: "Concrete template for Architectural Decision Records (MADR 3.0+ compatible with Agent Guardrails)"
  version: "1.1.0"
  introspection:
    template_id: adr
    tier: concrete
    parent: tier2_base_markdown
    variables:
      required:
        - title
        - status
        - version
        - last_updated
        - problem_statement
        - considered_options
        - decision_outcome
        - rationale
-#}

{% block header_fields -%}
**Status:** {{ status }}  
**Version:** {{ version }}  
**Last Updated:** {{ last_updated }}  
**Supersedes:** {{ supersedes | default('None') }}  
**Superseded By:** {{ superseded_by | default('None') }}  
{% if deciders -%}
**Deciders:** {{ deciders | join(', ') }}  
{% endif -%}
{% endblock %}

{% block document_content -%}

---

## Context & Problem Statement

{{ problem_statement }}

{% if decision_drivers %}
### Decision Drivers

{% for driver in decision_drivers -%}
- {{ driver }}
{% endfor %}
{% endif %}

---

## Considered Options

{% for option in considered_options %}
### {{ option.name }}

{% if option.description %}
{{ option.description }}

{% endif %}
**Pros (+):**
{% if option.pros %}
{% for pro in option.pros -%}
- {{ pro }}
{% endfor %}
{% else %}
- None identified
{% endif %}

**Cons (-):**
{% if option.cons %}
{% for con in option.cons -%}
- {{ con }}
{% endfor %}
{% else %}
- None identified
{% endif %}

{% endfor %}

---

## Decision Outcome

**Chosen Option:** {{ decision_outcome }}

### Rationale

{{ rationale }}

---

## Consequences

{% if consequences_positive %}
### Positive Consequences (+)

{% for pos in consequences_positive -%}
- {{ pos }}
{% endfor %}

{% endif %}
{% if consequences_negative %}
### Negative Consequences & Risks (-)

{% for neg in consequences_negative -%}
- {{ neg }}
{% endfor %}

{% endif %}
{% if agent_guardrails %}
### Agent Implementation Guardrails

{% for guardrail in agent_guardrails -%}
- {{ guardrail }}
{% endfor %}

{% endif %}
{% if confirmation %}

---

## Confirmation & Verification

{{ confirmation }}
{% endif %}

{% endblock %}
